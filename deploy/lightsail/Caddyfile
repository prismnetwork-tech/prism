{
	admin off
	email {$PRISM_ACME_EMAIL}
}

{$PRISM_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@proof_index path /proof-artifacts/index.json
	handle @proof_index {
		root * /srv/proof
		rewrite * /index.json
		header Cache-Control "no-cache"
		file_server
	}

	@proof_pages path /proof-artifacts/pages/*
	handle @proof_pages {
		root * /srv/proof
		uri strip_prefix /proof-artifacts
		header Cache-Control "public, max-age=30"
		file_server
	}

	@proof_sets path /proof-artifacts/sets/*
	handle @proof_sets {
		root * /srv/proof
		uri strip_prefix /proof-artifacts
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@proof_receipts path /proof-artifacts/receipts/*
	handle @proof_receipts {
		root * /srv/proof
		uri strip_prefix /proof-artifacts
		header Cache-Control "public, max-age=30"
		file_server
	}

	handle_path /proof-artifacts/* {
		root * /srv/proof
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
