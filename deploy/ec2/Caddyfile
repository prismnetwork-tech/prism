{
	admin off
	email {$PRISM_ACME_EMAIL}
}

{$PRISM_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /proof/* {
		root * /srv
		file_server
		header Content-Type "application/json"
		header Access-Control-Allow-Origin "*"
	}

	# The gateway answers only what carries its credential, and the edge is
	# what holds it: the paid routes stay open to anyone who pays, and the free
	# ones that name the leases and the takings are reachable only through here.
	handle /.well-known/x402.json {
		reverse_proxy inference:8500 {
			header_up Authorization "Bearer {$PRISM_INFERENCE_TOKEN}"
		}
	}

	handle /inference/* {
		uri strip_prefix /inference
		reverse_proxy inference:8500 {
			header_up Authorization "Bearer {$PRISM_INFERENCE_TOKEN}"
		}
	}

	handle {
		reverse_proxy control-plane:8080
	}
}

prismnetwork.tech, www.prismnetwork.tech {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy https://prism-network-web.onrender.com {
		header_up Host prism-network-web.onrender.com
	}
}

registry.prismnetwork.tech {
	# Pulls are open because the image is the public website. Publishing is not.
	# The hash lives in registry-auth/htpasswd on the host, not in the repo.
	@write not method GET HEAD OPTIONS
	basic_auth @write {
		prism-deploy {$PRISM_REGISTRY_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy registry:5000
}
