FROM rust:1.94-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
COPY workers ./workers
COPY node ./node
# A workspace member cargo cannot find fails the manifest for every binary, not
# just its own, so every member the lockfile names has to be here even when no
# service links it.
COPY tools ./tools
ARG BINARY
RUN test -n "${BINARY}"
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/workspace/target \
    cargo build --locked --release --bin "${BINARY}" --jobs 1 \
    && cp "/workspace/target/release/${BINARY}" /workspace/prism-service

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
ARG BINARY
RUN useradd --system --create-home --uid 10001 prism \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && if [ "$BINARY" = "prism-repro-worker" ]; then \
         apt-get install --yes --no-install-recommends openssh-client; \
       fi \
    && rm -rf /var/lib/apt/lists/*
RUN test -n "${BINARY}"
# The commit this image was built from. Services record it so a deployment that
# has fallen behind the repository is visible without inspecting image digests
# by hand, which is how a worker once ran six-day-old code unnoticed.
ARG GIT_SHA=unknown
ENV PRISM_BUILD_SHA=${GIT_SHA}
COPY --from=build /workspace/prism-service /usr/local/bin/prism-service
USER prism
ENTRYPOINT ["/usr/local/bin/prism-service"]
