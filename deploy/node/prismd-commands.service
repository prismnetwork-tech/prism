[Unit]
Description=Prism Network node command supervisor
After=network-online.target containerd.service
Wants=network-online.target
Requires=containerd.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/prismd/node.env
ExecStart=/usr/local/sbin/prismd commands \
  --identity /var/lib/prismd/device.json \
  --control-plane ${PRISM_CONTROL_PLANE_URL} \
  --workspace-root /var/lib/prismd/workspaces \
  --state-root /var/lib/prismd/leases
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
# nerdctl keeps its own volume and container state outside the daemon's, and it
# talks to containerd over a socket, so both have to stay writable or every
# workspace dies at `mkdir ... read-only file system`.
# The idle directories carry a '-' because a host with no idle workload never
# creates them, and a missing hard entry stops the unit from starting.
ReadWritePaths=/var/lib/prismd /run/lock/prismd /var/lib/nerdctl /run/containerd /etc/cni/net.d /var/lib/cni /run/cni /run/netns -/var/lib/prismd/idle -/var/lib/prismd/idle-state
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
