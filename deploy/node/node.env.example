PRISM_CONTROL_PLANE_URL=https://api.example.invalid/
PRISM_GATEWAY_ADDRESS=gateway.example.invalid:7443
PRISM_GATEWAY_SERVER_NAME=gateway.example.invalid
PRISM_CONNECTION_ID=replace-with-device-specific-identifier

# Isolation mode, fixed for the life of the daemon. Unset means kata-vfio: the
# GPU is bound to vfio-pci and the workload runs in a Kata guest. Set it to
# shared to leave the card with the host driver and run the workload in a
# container. OPEN_MODE.md covers shared.
#PRISM_ISOLATION=shared

# Card to serve under shared. Optional when the host shows one GPU, required
# when it shows several. Read the values from
# `nvidia-smi --query-gpu=index,uuid,name --format=csv`.
#PRISM_GPU_UUID=GPU-00000000-0000-0000-0000-000000000000

# Per-lease limits under shared. The defaults are 75% of host RAM and one core
# fewer than the host has.
#PRISM_LEASE_MEMORY_MIB=49152
#PRISM_LEASE_CPUS=7

# Workload to run between leases, described by idle.json.example. Unset means
# the host idles between leases, which is the default. Configuring it under
# kata-vfio is refused at startup, because the card is not the host's to use.
#PRISM_IDLE_CONFIG=/etc/prismd/idle.json
