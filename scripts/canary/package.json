{
  "name": "prism-canary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capped mainnet canary: fund a short GPU lease, verify nvidia-smi, print the on-chain funding tx.",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node canary.mjs",
    "repro:review": "node repro.mjs --review",
    "repro:execute": "node repro.mjs --execute",
    "repro:verify-cleanup": "node repro.mjs --verify-cleanup",
    "repro:inspect": "node repro.mjs --inspect",
    "test": "node --test config.test.mjs repro-core.test.mjs repro-runner.test.mjs",
    "check": "npm test && node canary.mjs --dry-run"
  },
  "dependencies": {
    "@prismnetwork/agent-sdk": "0.7.2",
    "viem": "^2"
  }
}
