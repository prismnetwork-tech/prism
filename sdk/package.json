{
  "name": "@prismnetwork/agent-sdk",
  "version": "0.7.2",
  "description": "Headless GPU leasing and renter-encrypted storage on Prism Network for wallet-holding agents.",
  "type": "module",
  "main": "prism.mjs",
  "exports": {
    ".": {
      "types": "./prism.d.mts",
      "default": "./prism.mjs"
    },
    "./attest": {
      "types": "./attest.d.mts",
      "default": "./attest.mjs"
    },
    "./e2ee": {
      "types": "./e2ee.d.mts",
      "default": "./e2ee.mjs"
    },
    "./toolset": {
      "types": "./toolset.d.mts",
      "default": "./toolset.mjs"
    },
    "./vault": {
      "types": "./vault.d.ts",
      "default": "./vault.mjs"
    },
    "./workspace": {
      "types": "./workspace.d.ts",
      "default": "./workspace.mjs"
    }
  },
  "files": [
    "prism.mjs",
    "prism.d.mts",
    "attest.mjs",
    "attest.d.mts",
    "e2ee.mjs",
    "e2ee.d.mts",
    "relay.mjs",
    "toolset.mjs",
    "toolset.d.mts",
    "vault.mjs",
    "vault.d.ts",
    "workspace.mjs",
    "workspace.d.ts",
    "vendor/aci-verifier/*.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "viem": "^2.55.11"
  },
  "keywords": [
    "prism",
    "gpu",
    "agent",
    "web3",
    "usdg",
    "compute",
    "llm",
    "tee",
    "attestation"
  ],
  "homepage": "https://prismnetwork.tech",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "types": "prism.d.mts",
  "dependencies": {
    "@phala/dcap-qvl": "^0.6.1",
    "jose": "^6.0.0"
  }
}
