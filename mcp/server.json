{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.prismnetwork-tech/mcp",
  "description": "Rent real NVIDIA GPUs from your agent. Browse with no wallet; pay per second onchain.",
  "version": "0.9.0",
  "websiteUrl": "https://prismnetwork.tech",
  "repository": {
    "url": "https://github.com/prismnetwork-tech/prism",
    "source": "github",
    "subfolder": "mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@prismnetwork/mcp",
      "version": "0.9.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PRISM_AGENT_KEY",
          "description": "Agent wallet private key (0x...). Only needed to lease and pay; browsing works without it",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PRISM_ESCROW",
          "description": "Prism LeaseEscrow contract address",
          "isRequired": false,
          "default": "0x62C042265991bEa17B07229322A01850974626dA"
        }
      ]
    }
  ]
}
